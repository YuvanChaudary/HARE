# ==============================================================================
# Heat Action Response Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your local keys.
# NEVER commit the actual '.env' file to Git!

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. AI INFERENCE (NVIDIA NIM / OLLAMA)
# ------------------------------------------------------------------------------
# Select provider: "nvidia", "ollama", or "mock"
AI_PROVIDER=nvidia

# NVIDIA NIM Cloud API (Get your key at: https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-your-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Local Ollama Inference (Zero key required; runs on your PC)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# 3. WEATHER TELEMETRY (OPEN-METEO)
# ------------------------------------------------------------------------------
# Open-Meteo free tier requires NO API KEY for development!
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 4. STORAGE DRIVER
# ------------------------------------------------------------------------------
# Use "local_json" for local development, "dynamodb" when deploying to AWS
STORAGE_DRIVER=local_json
LOCAL_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 5. AWS CLOUD (Only needed when migrating from local JSON to AWS)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_TABLE_NAME=HeatActionEngine-Dev
